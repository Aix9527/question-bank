# ===== 专科复习在线题库 · API 环境变量模板（v0.6-cloud） =====
# 复制为 .env（本地）或在 Vercel Project 中逐项配置（生产）。
# 不要把真实密码/密钥提交到 Git。

# 运行环境：development / production
APP_ENV=development

# ---- 数据库 ----
# 本地开发（SQLite）：
DATABASE_URL=sqlite:///./question_bank.db
# 生产（Vercel FastAPI → Supabase Transaction Pooler，端口 6543）：
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# 迁移/管理（Session Pooler，端口 5432）：
# DATABASE_MIGRATION_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Supabase Storage（第二阶段的 DOCX/导出/备份存储，本阶段可留空） ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-bank

# ---- 跨域与安全 ----
# 生产改为实际前端域名，如 https://question-bank-web.vercel.app
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 生产需要走登录门禁
QUESTION_BANK_AUTH_REQUIRED=true
QUESTION_BANK_BOOTSTRAP_ADMIN_USERNAME=admin
# 生产必须替换为强密码（勿提交）
QUESTION_BANK_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 可选 AI 主观题建议分 ----
QUESTION_BANK_AI_PROVIDER=disabled
OPENAI_API_KEY=
