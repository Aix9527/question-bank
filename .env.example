# v0.5 deployment defaults to login-required mode.
QUESTION_BANK_AUTH_REQUIRED=true
QUESTION_BANK_AUTH_SESSION_HOURS=168
QUESTION_BANK_BOOTSTRAP_ADMIN_USERNAME=admin
# REQUIRED for Docker: replace before first start.
QUESTION_BANK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Legacy local automation fallback only. Auth-required deployment does not use this for browser login.
QUESTION_BANK_ADMIN_TOKEN=

# Browser-facing addresses. Replace with the real domain/IP when deploying remotely.
PUBLIC_API_BASE=http://127.0.0.1:8000
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
QUESTION_BANK_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Set true only when the web site itself is served over HTTPS.
QUESTION_BANK_COOKIE_SECURE=false

# Optional advisory AI grading. Human final review remains mandatory.
QUESTION_BANK_AI_PROVIDER=disabled
QUESTION_BANK_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
